# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Your Discord user ID; owner-only commands use this value.
DISCORD_OWNER_ID=

# MongoDB connection string for the same database used by Kelin-MD2.
MONGO_URI=

# Command prefix shared by the Discord adapter.
PREFIX=.

# Message Content must be enabled under Discord Developer Portal → Bot →
# Privileged Gateway Intents for prefix commands to work.
# Guild Members is also required for welcome/goodbye join and leave events.
DISCORD_ENABLE_GUILD_MEMBERS=false

# Keep the economy rule aligned with Kelin-MD2's configured wallet policy.
WALLET_CAP=300000000000

# Hosting platforms usually provide PORT automatically.
PORT=8080

# Check origin/<current-branch> before each panel/server restart.
# Set false if this deployment is managed by another release process.
AUTO_UPDATE=true
# Optional: override the branch checked by the updater.
# AUTO_UPDATE_BRANCH=master
# Optional: override the public GitHub repository used when the panel has no .git directory.
# AUTO_UPDATE_REPOSITORY=kelin132/AKIRA-DISCORD
# Set false only if the host installs dependencies separately.
# AUTO_INSTALL_DEPENDENCIES=true

# Set true only when the hosting platform does not need an HTTP health endpoint.
DISABLE_HEALTH_SERVER=false
