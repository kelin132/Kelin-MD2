# MongoDB connection string used by the existing Kelin-MD2 database.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/

# Long random value used to sign AIDORU login sessions.
SESSION_SECRET=replace-with-a-long-random-string

# Discord OAuth application settings for website account linking.
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
# This must exactly match a Redirect URI in the Discord Developer Portal.
# The website accepts both the root callback and /profile?discord=callback.
DISCORD_REDIRECT_URI=https://aidoru.zone.id
# Optional separate login callback. Leave unset to use DISCORD_REDIRECT_URI.
# If set, register this exact URI in Discord too.
# DISCORD_LOGIN_REDIRECT_URI=https://aidoru.zone.id